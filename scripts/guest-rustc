#!/bin/sh
# cargo's rustc wrapper for this tree (.cargo/config.toml): rustc calls for the zkVM target go through
# scripts/guest-rustc.py, which makes a RISC Zero guest's ELF and image id independent of where the tree, the cargo
# home and the toolchains are (see there); every other call runs rustc unchanged.
case " $* " in
  *" --target riscv32im-risc0-zkvm-elf "* | *" --target=riscv32im-risc0-zkvm-elf "*)
    exec python3 -I "$(dirname "$0")/guest-rustc.py" "$@" ;;
esac
exec "$@"
