From d3f4f782621bf0bbe40903ec4dc6efcad29c3154 Mon Sep 17 00:00:00 2001
From: Ferrata <ferrata@localhost>
Date: Thu, 26 Nov 2026 10:08:28 +0000
Subject: [PATCH 1/2] feat(idl): describe tuples as positional-field structs in
 generated IDLs

A non-empty tuple is Borsh-encoded as its elements in order, exactly as a
struct with positional fields is, so the generator now describes it as such
a struct, named after its element types ((Root, u128) becomes
Tuple_Root_u128). The IDL grammar needs no new form and every decoder
already reads it. A derived name that a type of the crate, or another tuple
whose element types differ only in the characters the name drops, already
holds is refused rather than shared. The empty tuple () and references are
still refused.
---
 spel-framework-core/src/idl_gen.rs | 43 +++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/spel-framework-core/src/idl_gen.rs b/spel-framework-core/src/idl_gen.rs
index 267d331..f8236fb 100644
--- a/spel-framework-core/src/idl_gen.rs
+++ b/spel-framework-core/src/idl_gen.rs
@@ -419,7 +419,48 @@ impl<'a> Collector<'a> {
                     array: (Box::new(self.idl_type(&array.elem, used_by, depth)?), len),
                 })
             },
-            _ => Err(unsupported("only paths and arrays are supported")),
+            // A tuple is Borsh-encoded as its elements in order, exactly as a struct with positional fields is:
+            // describe it as such a struct, named after its element types (`(Root, u128)` -> `Tuple_Root_u128`),
+            // so that the IDL's grammar needs no new form and every decoder already reads it.
+            Type::Tuple(tuple) if !tuple.elems.is_empty() => {
+                let mut fields = Vec::with_capacity(tuple.elems.len());
+                let mut parts = Vec::with_capacity(tuple.elems.len());
+                for (position, elem) in tuple.elems.iter().enumerate() {
+                    parts.push(quote_type(elem).replace(|c: char| !c.is_ascii_alphanumeric(), ""));
+                    fields.push(IdlField {
+                        name: position.to_string(),
+                        type_: self.idl_type(elem, used_by, depth)?,
+                        docs: None,
+                    });
+                }
+                let name = format!("Tuple_{}", parts.join("_"));
+                let def = IdlTypeDef {
+                    name: name.clone(),
+                    kind: "struct".to_owned(),
+                    fields,
+                    variants: vec![],
+                };
+                // A derived name never stands for two types: refused if the crate defines a type of that name, or if
+                // another tuple, whose element types differ only in the characters the name drops, took it first.
+                if self.index.get(&name).is_some() {
+                    return Err(unsupported(
+                        "its derived name is that of a type the crate defines",
+                    ));
+                }
+                match self.done.get(&name) {
+                    Some(existing) if *existing != def => {
+                        return Err(unsupported("its derived name is that of another tuple"));
+                    },
+                    Some(_) => {},
+                    None => {
+                        self.done.insert(name.clone(), def);
+                    },
+                }
+                Ok(IdlType::Defined { defined: name })
+            },
+            _ => Err(unsupported(
+                "only paths, arrays and non-empty tuples are supported",
+            )),
         }
     }
 }
-- 
