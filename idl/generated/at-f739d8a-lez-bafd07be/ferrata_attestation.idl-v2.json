            "vec": "u8"
          }
        }
      ],
      "name": "JobOpen",
      "tag": 9
    },
    {
      "docs": "`job(id, job_id)` → `instance(id)`: the verified job.",
      "fields": [
        {
          "name": "instance_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "job_id",
          "type": {
            "array": [
