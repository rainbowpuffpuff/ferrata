          "type": {
            "vec": "u8"
          }
        }
      ],
      "name": "Apply",
      "tag": 10
    },
    {
      "docs": "Any actor of this program → `instance(id)`: a job verified in one call by `VerifyAll`.",
      "fields": [
        {
          "name": "instance_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "job",
          "type": {
            "vec": "u8"
          }
        }
      ],
      "name": "ApplyVerified",
      "tag": 11
    },
    {
      "docs": "`instance(id)` → `header(id, slot)`: the record to write once (`HeaderRecord` encoding),\nwith the instance's chain id and root id.",
      "fields": [
        {
          "name": "instance_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "slot",
          "type": "u64"
        },
        {
          "name": "chain_id",
          "type": "u64"
        },
        {
          "name": "record",
          "type": {
            "vec": "u8"
          }
        },
        {
          "name": "root_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        }
      ],
      "name": "Record",
      "tag": 12
    },
    {
      "docs": "At `instance(id)`, anyone: create a successor of this instance with `config`, whose\ncheckpoint is this instance's latest record `checkpoint` (its finalized header's root). The\ninstance checks the three invariants: `config` copies every immutable field of its own\nconfiguration except the fork schedule, which must agree on every fork at or before the\ncheckpoint's epoch; `checkpoint` is its latest record; and that record is inside the\nweak-subjectivity period (the transaction is valid only before the period ends). Then it\nsends `Spawn` to `instance(successor_id(root id, id, config, checkpoint))` and emits\n[`SUCCEEDED_SELECTOR`].",
      "fields": [
        {
          "name": "config",
          "type": {
            "defined": "Config"
          }
        },
        {
          "name": "checkpoint",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        }
      ],
      "name": "Succeed",
      "tag": 13
    },
    {
      "docs": "`instance(parent_id)` → `instance(successor_id(..))`: create the successor, active, with the\nparent's store and root id.",
      "fields": [
        {
          "name": "root_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "parent_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "checkpoint",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "config",
          "type": {
            "defined": "Config"
          }
        },
        {
          "name": "store",
          "type": {
            "vec": "u8"
          }
        }
      ],
      "name": "Spawn",
      "tag": 14
    }
