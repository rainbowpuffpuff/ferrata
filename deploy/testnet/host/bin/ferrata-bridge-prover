#!/opt/ferrata/venv-modal/bin/python3
"""The bridge demo's prover client: proofs on a Modal GPU, never on this host.

    ferrata-bridge-prover prove --kind release|checkpoint-b --input FILE (--journal 0x.. | --meta FILE.json) [--name N] [--inbox DIR]
    ferrata-bridge-prover watch --requests DIR --inbox DIR [--poll 10]
    ferrata-bridge-prover check

It calls `prove_bytes(program, input, meta, groth16=True)` of the Modal app `ferrata-prover` (gpu-prover/modal_app.py,
deployed with bin-31/ in a workspace that holds NO secret; its token, MODAL_TOKEN_ID and MODAL_TOKEN_SECRET in
/etc/ferrata/bridge-prover.env, is that workspace's): STARK and Groth16 on one GPU, the 260-byte seal the vault takes. The program is RISC Zero 3.1's
(docs/image-ids.md `*_31`, sha256 checked here): release_31 for a release input (the CLI's `ferrata release
--input-out`), checkpoint_b_0_3_5_31 for a rule (B) checkpoint input of this zone (Logos Blockchain 0.3.5-rc.1).
The result becomes a relayer inbox job, {"kind": "release"|"checkpoint", "journal": "0x..", "seal": "0x.."}, which the
relayer checks with the vault's own eth_call before it sends anything.

`watch` takes requests, `<requests>/<name>.json` = {"kind": ..., "input": "<file>", "journal": "0x.."}, one at a time;
the answer goes to `<requests>/done/<name>.json` (or `failed/`), the job to `<inbox>/<name>.json`.

Restarts and failures (RFP-022 R.6): the proof is started with `spawn` and its call id kept in `<requests>/calls/<name>.json`
before the client waits for it, so a client killed mid-proof and started again waits for the same call (Modal keeps
running it and keeps its result) instead of paying for a second proof. A proof that fails on the prover's side (its
container gone, a time limit, the app unreachable, the endpoint down) keeps the request: the call id is dropped and the
next poll starts it again, up to FERRATA_PROVE_ATTEMPTS (5) attempts; a request that cannot succeed (an unreadable request,
a program that is not the pinned one, no journal, a proof of another journal) goes to `failed/` at once. The inbox job is
written once: the call record notes the delivery, and a restart after it only finishes the request.
FERRATA_PROVER_PROGRAMS_JSON names a JSON file {kind: [file, image id, sha256, job kind]} that replaces the pinned
programs (another deployment's, or a test's).
"""
import argparse
import hashlib
import json
import os
import pathlib
import signal
import sys
import time

PROGRAMS = pathlib.Path(os.environ.get("FERRATA_PROGRAMS_31", "/opt/ferrata/programs/31"))
# docs/image-ids.md, RISC Zero 3.1 rows: (file, image id, sha256 of the binary)
KINDS = {
    "release": ("release.bin", "0xf279af414a8beef160a5a58cef741eba0269b7635a0ccc3d5d22e3c5d771a6fd",
                "d0fdcac9fa71ee87d22014ccfbb90f4ac543ae2559838d85a9dd0315c7cae2ac", "release"),
    "checkpoint-b": ("checkpoint_b_0_3_5.bin", "0x8917f58e76aa805dedc04fc5e2b70404f5078b66b271ec44aaa0c78d9f5eaf04",
                     "86eaa5502bffbb85d8661e18d24ae83a797cab5e2cdc4db70c01b6a7ae20bbdc", "checkpoint"),
}
if os.environ.get("FERRATA_PROVER_PROGRAMS_JSON"):
    KINDS = {k: tuple(v) for k, v in json.loads(pathlib.Path(os.environ["FERRATA_PROVER_PROGRAMS_JSON"]).read_text()).items()}
APP, FUNCTION = os.environ.get("FERRATA_PROVER_APP", "ferrata-prover"), "prove_bytes"
ATTEMPTS = int(os.environ.get("FERRATA_PROVE_ATTEMPTS", "5"))


class Permanent(Exception):
    """A request that cannot succeed by trying again."""


def write_atomic(path, text):
    path = pathlib.Path(path)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def program(kind):
    name, image, sha, job = KINDS[kind]
    data = (PROGRAMS / name).read_bytes()
    if hashlib.sha256(data).hexdigest() != sha:
        raise Permanent(f"{PROGRAMS / name}: not the binary of docs/image-ids.md ({sha[:16]}...)")
    return data, image, job


def hex0(s):
    return "0x" + s.removeprefix("0x").lower()


def prove(kind, input_path, journal, name, inbox=None, meta_path=None, calls=None):
    """One proof. `calls`: the directory of call records (watch): the call id is kept there before waiting, and a record
    left by a killed client is waited for again instead of starting a second proof."""
    import modal  # the client only; the token is the no-secret workspace's (MODAL_CONFIG_PATH)
    data, image, job_kind = program(kind)
    # The input's own meta (realblocks-crown's, crown-release's) when there is one, as the prover's local runs pass it.
    meta = json.loads(pathlib.Path(meta_path).read_text()) if meta_path else {}
    # The journal the proof must carry: --journal, else the meta's (the CLI's `release --input-out` writes it beside).
    journal = journal or meta.get("journal") or ""
    if not journal:
        raise Permanent("no journal: --journal 0x.., or a --meta file with \"journal\"")
    meta.update({"kind": kind, "journal": journal.removeprefix("0x"), "name": name})
    limit = int(os.environ.get("FERRATA_PROVE_LIMIT_S", "6600"))
    rec_path = pathlib.Path(calls) / f"{name}.json" if calls else None
    rec = json.loads(rec_path.read_text()) if rec_path and rec_path.exists() else {}
    t0 = time.time()
    resumed = bool(rec.get("call_id"))
    if resumed:
        call = modal.FunctionCall.from_id(rec["call_id"])
        print(json.dumps({"event": "resumed", "name": name, "call_id": rec["call_id"], "attempt": rec.get("attempts", 1)}), flush=True)
    else:
        call = modal.Function.from_name(APP, FUNCTION).spawn(data, pathlib.Path(input_path).read_bytes(), meta, limit_s=limit, groth16=True)
        rec = {"call_id": call.object_id, "attempts": rec.get("attempts", 0) + 1, "started": round(t0, 1)}
        if rec_path:
            write_atomic(rec_path, json.dumps(rec))
        print(json.dumps({"event": "spawned", "name": name, "call_id": call.object_id, "attempt": rec["attempts"]}), flush=True)
    r = rec.get("result") or call.get(timeout=limit + 600)
    out = {"name": name, "kind": kind, "image_id": image, "ok": bool(r.get("ok")), "seconds": round(time.time() - t0, 1),
           "journal": hex0(r.get("journal_hex") or ""), "seal": hex0(r.get("seal_hex") or ""),
           "prover": {k: r.get(k) for k in ("exit_code", "wall_s") if k in r}, "call_id": rec.get("call_id"),
           "attempts": rec.get("attempts", 1), "resumed": resumed}
    if out["ok"] and out["journal"] != hex0(journal):
        out["ok"], out["error"] = False, "the proof's journal is not the one asked for"
    if not out["ok"]:
        # The prover answered, and not with this journal's proof: trying again proves the same input again.
        raise Permanent(out.get("error") or f"the prover refused: {json.dumps(r.get('error') or r.get('exit_code'))[:300]}")
    if rec_path and not rec.get("result"):
        rec["result"] = {k: r.get(k) for k in ("ok", "journal_hex", "seal_hex", "exit_code", "wall_s") if k in r}
        write_atomic(rec_path, json.dumps(rec))
    if inbox:
        dest = pathlib.Path(inbox) / f"{name}.json"
        if rec.get("delivered"):
            out["job"], out["delivered_before"] = str(dest), True
        else:
            write_atomic(dest, json.dumps({"kind": job_kind, "journal": out["journal"], "seal": out["seal"]}))
            out["job"] = str(dest)
            if rec_path:
                rec["delivered"] = True
                write_atomic(rec_path, json.dumps(rec))
    return out


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("prove")
    p.add_argument("--kind", choices=sorted(KINDS), required=True)
    p.add_argument("--input", required=True)
    p.add_argument("--journal")
    p.add_argument("--name", default=time.strftime("job-%Y%m%dT%H%M%SZ", time.gmtime()))
    p.add_argument("--inbox")
    p.add_argument("--meta")
    w = sub.add_parser("watch")
    w.add_argument("--requests", required=True)
    w.add_argument("--inbox", required=True)
    w.add_argument("--poll", type=int, default=10)
    sub.add_parser("check")
    a = ap.parse_args()
    if a.cmd == "check":  # the programs and the app, without proving anything
        for k in KINDS:
            program(k)
        import modal
        modal.Function.from_name(APP, FUNCTION).hydrate()
        print(json.dumps({"ok": True, "app": APP, "programs": {k: v[1] for k, v in KINDS.items()}}))
        return
    if a.cmd == "prove":
        r = prove(a.kind, a.input, a.journal, a.name, a.inbox, a.meta)
        print(json.dumps(r))
        sys.exit(0 if r["ok"] else 1)
    req = pathlib.Path(a.requests)
    for d in ("done", "failed", "calls"):
        (req / d).mkdir(exist_ok=True)
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    print(json.dumps({"event": "started", "requests": str(req), "inbox": a.inbox}), flush=True)
    while not stop:
        for f in sorted(req.glob("*.json")):
            name, rec_path = f.stem, req / "calls" / f.name
            try:
                q = json.loads(f.read_text())
                r = prove(q["kind"], q["input"], q.get("journal"), name, a.inbox, q.get("meta"), calls=req / "calls")
                where = "done"
            except Exception as e:  # noqa: BLE001
                rec = json.loads(rec_path.read_text()) if rec_path.exists() else {}
                permanent = isinstance(e, (Permanent, ValueError, KeyError, OSError)) and not _transient(e)
                r = {"name": name, "ok": False, "error": repr(e)[:500], "attempts": rec.get("attempts", 0)}
                if not permanent and rec.get("attempts", 0) < ATTEMPTS:
                    # The prover's side failed (or the client could not reach it): the request stays, the call id goes,
                    # and the next poll starts the proof again.
                    rec.pop("call_id", None)
                    rec.setdefault("errors", []).append(r["error"][:200])
                    write_atomic(rec_path, json.dumps(rec))
                    print(json.dumps({"event": "retry", "name": name, "attempts": rec.get("attempts", 0), "error": r["error"][:200]}), flush=True)
                    continue
                where = "failed"
            write_atomic(req / where / f.name, json.dumps(r))
            f.unlink()
            rec_path.unlink(missing_ok=True)
            print(json.dumps({k: r.get(k) for k in ("name", "kind", "ok", "seconds", "job", "error", "call_id", "attempts", "resumed")}), flush=True)
            if stop:
                break
        if not stop:
            time.sleep(a.poll)
    print(json.dumps({"event": "stop", "reason": "SIGTERM"}), flush=True)


def _transient(e):
    """An error of the network or of the prover's side, not of the request: worth another attempt."""
    names = {c.__name__ for c in type(e).__mro__}
    return bool(names & {"ConnectionError", "TimeoutError", "RemoteError", "FunctionTimeoutError", "OutputExpiredError",
                         "InputCancellation", "InternalFailure", "ExecutionError", "URLError"})


if __name__ == "__main__":
    main()
