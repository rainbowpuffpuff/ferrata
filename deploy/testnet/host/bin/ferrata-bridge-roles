#!/usr/bin/env bash
# The bridge configuration's two LEZ roles on this zone (the `controls` its configId commits to): an admin and a freeze
# authority, two fresh LEZ keys made here with `ferrata-day1 keygen` (mode 600, user ferrata, never printed), their
# public account ids in /var/lib/ferrata/bridge/roles.json as `crown-driver config-id` takes them (CROWN_ADMIN,
# CROWN_FREEZE_AUTHORITY). Idempotent; run as root. Nothing is sent.
set -euo pipefail
DATA=/var/lib/ferrata
as_ferrata() { runuser -u ferrata -- env XDG_CACHE_HOME=/opt/ferrata/cache RISC0_SERVER_PATH=/opt/ferrata/bin/r0vm "$@"; }
for role in admin freeze-authority; do
  k="$DATA/keys/bridge-$role"
  [ -f "$k/payer.key" ] || as_ferrata /opt/ferrata/bin/ferrata-day1 keygen --keys "$k" > /dev/null
done
python3 -I - "$DATA/keys/bridge-admin/accounts.json" "$DATA/keys/bridge-freeze-authority/accounts.json" <<'EOF' > "$DATA/bridge/roles.json"
import json, sys
B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
def hex32(s):
    n = 0
    for c in s:
        n = n * 58 + B58.index(c)
    return "0x" + n.to_bytes(32, "big").hex()
a, f = (json.load(open(p))["payer"] for p in sys.argv[1:3])
print(json.dumps({"admin": hex32(a), "freezeAuthority": hex32(f), "admin_base58": a, "freezeAuthority_base58": f}))
EOF
chmod 644 "$DATA/bridge/roles.json"
cat "$DATA/bridge/roles.json"
