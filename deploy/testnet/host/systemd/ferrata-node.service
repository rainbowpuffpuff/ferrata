[Unit]
Description=Logos Blockchain node (Bedrock) of the Ferrata LEZ testnet: one validator, LEZ v0.4.0-rc3's local config
After=network-online.target chrony.service
Wants=network-online.target
RequiresMountsFor=/var/lib/ferrata

[Service]
User=ferrata
Group=ferrata
WorkingDirectory=/var/lib/ferrata/node
# As LEZ's container runs it (bedrock/scripts/run_logos_blockchain_node.sh): leader proofs in dev mode.
Environment=POL_PROOF_DEV_MODE=true
ExecStart=/opt/ferrata/bin/bedrock/logos-blockchain-node node-config.yaml --deployment deployment-settings.yaml
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
StandardOutput=append:/var/log/ferrata/node.log
StandardError=append:/var/log/ferrata/node.log
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ferrata/node /var/log/ferrata

[Install]
WantedBy=multi-user.target
