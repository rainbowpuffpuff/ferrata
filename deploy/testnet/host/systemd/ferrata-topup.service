[Unit]
Description=Keep the sequencer's Bedrock funding key funded (claims the leader's rewards; never spends the SDP key)
After=ferrata-node.service

[Service]
Type=oneshot
User=ferrata
Group=ferrata
ExecStart=/usr/bin/python3 -I /opt/ferrata/bin/ferrata-topup
StandardOutput=append:/var/log/ferrata/topup.log
StandardError=append:/var/log/ferrata/topup.log
