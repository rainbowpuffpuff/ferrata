+/// eth_getLogs, tried again while a load-balanced endpoint's backend lags the head another one reported ("block range
+/// extends beyond current head block") or the failure is [`transient`]: up to ten attempts, 2 s apart.
+async fn get_logs_settled(
+    p: &DynProvider,
+    filter: &Filter,
+) -> std::result::Result<Vec<alloy::rpc::types::Log>, RpcError<TransportErrorKind>> {
+    let mut attempt = 0;
+    loop {
+        match p.get_logs(filter).await {
+            Ok(v) => return Ok(v),
+            Err(e) if attempt < 9 && (transient(&e) || e.to_string().contains("beyond current head")) => {
+                attempt += 1;
+                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+            }
+            Err(e) => return Err(e),
+        }
+    }
+}
