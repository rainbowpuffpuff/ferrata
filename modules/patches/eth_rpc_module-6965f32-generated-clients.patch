From 7087233c39535722c1043a0916f447b4ac5a0f75 Mon Sep 17 00:00:00 2001
From: ferrata <ferrata@invalid>
Date: Sat, 14 Nov 2026 16:17:41 +0100
Subject: [PATCH] fix: glue for the clients logos-module-builder 5f74cdb
 generates

The verified_proxy_module client that builder 5f74cdb (logos-rust-sdk 040e94e) generates
returns status() as BTreeMap<String, Value> ({tstr: any}) and takes rpc()'s params as
&[Value] ([any]); the glue was written for the older generator's Value and &Value, and
eth_rpc_module does not compile against the new client (glue.rs 212, 247: E0308).
The map goes back into the object the gate reads; the params go as the array's elements,
which the client sends as the same JSON array (verified_params always builds an array).
---
 rust-lib/src/glue.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/rust-lib/src/glue.rs b/rust-lib/src/glue.rs
index 6d22beb..29930b3 100644
--- a/rust-lib/src/glue.rs
+++ b/rust-lib/src/glue.rs
@@ -208,9 +208,12 @@ impl GateProbe for VerifiedProxyRouter {
     /// `status` is declared `-> {tstr: any}`, NOT `-> result`, so it answers the object itself
     /// rather than a {success,value,error} envelope. Reading `value.state` here would silently
     /// see nothing and call every healthy proxy unusable.
+    ///
+    /// The generated client decodes `{tstr: any}` into a map; the gate reads it as the object.
     fn proxy_status(&self) -> std::result::Result<Value, String> {
         verified_proxy_module::VerifiedProxyModuleClient::new()
             .status_with_timeout(PROBE_BUDGET)
+            .map(|status| Value::Object(status.into_iter().collect()))
             .map_err(|e| format!("{e:?}"))
     }
 
@@ -243,6 +246,9 @@ impl VerifiedRouter for VerifiedProxyRouter {
                 budget.as_millis()
             )));
         };
+        // `rpc`'s `params` is `[any]`: the generated client takes the elements and sends them as
+        // the same JSON array. `verified_params` always hands this router an array.
+        let params = params.as_array().map(Vec::as_slice).unwrap_or_default();
         let raw = verified_proxy_module::VerifiedProxyModuleClient::new()
             .rpc_with_timeout(method, params, left)
             .map_err(|e| RouterError::Failed(format!("{method} failed ({e:?})")))?;
