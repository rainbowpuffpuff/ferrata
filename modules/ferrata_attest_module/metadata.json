{
  "name": "ferrata_attest_module",
  "display_name": "Ferrata attestation",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "category": "ethereum",
  "description": "Ferrata (prototype): dry-run an Ethereum attestation against a header record and verify a light-client checkpoint, with the program's verification core",
  "main": "ferrata_attest_module_plugin",
  "dependencies": [],
  "optional_dependencies": [{ "name": "eth_rpc_module", "version": "~0.2.0" }],
  "dependency_overrides": { "eth_rpc_module": { "file": "deps/eth_rpc_module.lidl" } },

  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "FerrataAttestModule" }
  },

  "nix": {
    "packages": {
      "build": [],
      "runtime": []
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
