--- /dev/null
+++ b/rust-lib/src/checkpoint.rs
@@ -0,0 +1,157 @@
+//! `verify_checkpoint`: check a light client's trusted checkpoint (a block root) against this chain's providers before
+//! relying on it. The answers of the providers are not trusted one by one: each is asked, pinned (no failover), whether
+//! the root is a canonical block, the canonical block at its own slot, at or below what it has finalized, on the chain
+//! the caller expects (genesis, deposit chain id); the checkpoint passes when enough providers on distinct hosts agree and
+//! none disagrees. A provider that cannot answer is not counted either way.
+//!
+//! This is the check a light client deployed elsewhere (for instance an Ethereum light client inside a LEZ program)
+//! needs before anyone binds to it: an independent verification of its weak-subjectivity checkpoint against public
+//! Ethereum sources.
+
+use std::collections::BTreeSet;
+
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+use crate::beacon::{get_path, network, Plan};
+
+/// What the caller expects of the chain. Unset fields are taken from the chain's known network where there is one
+/// (`genesis_time`; the deposit chain id is the chain id), and otherwise not checked.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct CheckpointExpect {
+    pub genesis_validators_root: Option<String>,
+    pub genesis_time: Option<u64>,
+    pub deposit_chain_id: Option<u64>,
+    /// Agreeing providers on distinct hosts needed (default 3).
+    pub min_providers: Option<usize>,
+}
+
+fn norm(h: &str) -> String {
+    format!("0x{}", h.trim().trim_start_matches("0x").trim_start_matches("0X").to_ascii_lowercase())
+}
+
+fn num(v: &Value) -> Option<u64> {
+    v.as_str().and_then(|s| s.parse().ok()).or_else(|| v.as_u64())
+}
+
+fn host(endpoint: &str) -> String {
+    url::Url::parse(endpoint)
+        .ok()
+        .and_then(|u| u.host_str().map(|h| match u.port() {
+            Some(p) => format!("{h}:{p}"),
+            None => h.to_string(),
+        }))
+        .unwrap_or_else(|| endpoint.to_string())
+}
+
+/// One provider's answers, judged.
+struct Judged {
+    agree: bool,
+    disagree: Vec<String>,
+    unavailable: Vec<String>,
+    slot: Option<u64>,
+    finalized_slot: Option<u64>,
+}
+
+impl Plan {
+    /// Every enabled provider asked about the block root `root` (see the module documentation).
+    /// `{ ok, chainId, root, verdict: "ok" | "failed", agreeing, needed, slot, providers: [...] }`.
+    pub fn verify_checkpoint(&self, root: &str, expect: &CheckpointExpect) -> Value {
+        let root = norm(root);
+        let known = network(self.chain_id);
+        let genesis_time = expect.genesis_time.or(known.map(|n| n.genesis_time));
+        let deposit_chain_id = expect.deposit_chain_id.or(Some(self.chain_id));
+        let gvr = expect.genesis_validators_root.as_deref().map(norm);
+        let needed = expect.min_providers.unwrap_or(3);
+        let client = match self.client() {
+            Ok(c) => c,
+            Err(e) => return json!({ "ok": false, "error": e.to_string() }),
+        };
+        let timeout = std::time::Duration::from_secs(self.cfg.timeout_secs);
+        let mut providers = Vec::new();
+        let mut agreeing_hosts = BTreeSet::new();
+        let mut slots = BTreeSet::new();
+        let mut any_disagree = false;
+        for p in self.cfg.providers.iter().filter(|p| p.enabled) {
+            let ask = |path: &str| get_path(&client, &p.endpoint, path, timeout);
+            let mut j = Judged { agree: false, disagree: vec![], unavailable: vec![], slot: None, finalized_slot: None };
+            // 1. The root: a canonical block.
+            match ask(&format!("/eth/v1/beacon/headers/{root}")) {
+                Ok(Some(v)) => {
+                    let d = &v["data"];
+                    if d["root"].as_str().map(norm) != Some(root.clone()) {
+                        j.disagree.push("answers another root for it".into());
+                    } else if d["canonical"].as_bool() == Some(false) {
+                        j.disagree.push("not canonical".into());
+                    }
+                    j.slot = num(&d["header"]["message"]["slot"]);
+                }
+                Ok(None) => j.disagree.push("does not know the root".into()),
+                Err(e) => j.unavailable.push(format!("headers/{{root}}: {e}")),
+            }
+            // 2. The canonical block at its slot is the root.
+            if let (Some(slot), true) = (j.slot, j.disagree.is_empty() && j.unavailable.is_empty()) {
+                match ask(&format!("/eth/v1/beacon/headers/{slot}")) {
+                    Ok(Some(v)) if v["data"]["root"].as_str().map(norm) == Some(root.clone()) => {}
+                    Ok(Some(_)) | Ok(None) => j.disagree.push(format!("another block (or none) at slot {slot}")),
+                    Err(e) => j.unavailable.push(format!("headers/{slot}: {e}")),
+                }
+                // 3. Finalized there.
+                match ask("/eth/v1/beacon/headers/finalized") {
+                    Ok(Some(v)) => {
+                        j.finalized_slot = num(&v["data"]["header"]["message"]["slot"]);
+                        if j.finalized_slot.is_none_or(|f| f < slot) {
+                            j.disagree.push(format!("has not finalized slot {slot}"));
+                        }
+                    }
+                    Ok(None) => j.unavailable.push("headers/finalized: HTTP 404".into()),
+                    Err(e) => j.unavailable.push(format!("headers/finalized: {e}")),
+                }
+            }
+            // 4. The chain: its genesis and deposit chain id.
+            match ask("/eth/v1/beacon/genesis") {
+                Ok(Some(v)) => {
+                    let d = &v["data"];
+                    if gvr.as_ref().is_some_and(|g| d["genesis_validators_root"].as_str().map(norm).as_ref() != Some(g)) {
+                        j.disagree.push("another genesis_validators_root".into());
+                    }
+                    if genesis_time.is_some_and(|t| num(&d["genesis_time"]) != Some(t)) {
+                        j.disagree.push("another genesis_time".into());
+                    }
+                }
+                Ok(None) => j.unavailable.push("genesis: HTTP 404".into()),
+                Err(e) => j.unavailable.push(format!("genesis: {e}")),
+            }
+            match ask("/eth/v1/config/spec") {
+                Ok(Some(v)) => {
+                    if deposit_chain_id.is_some_and(|c| num(&v["data"]["DEPOSIT_CHAIN_ID"]) != Some(c)) {
+                        j.disagree.push("another DEPOSIT_CHAIN_ID".into());
+                    }
+                }
+                Ok(None) => j.unavailable.push("config/spec: HTTP 404".into()),
+                Err(e) => j.unavailable.push(format!("config/spec: {e}")),
+            }
+            let verdict = if !j.disagree.is_empty() {
+                any_disagree = true;
+                "disagrees"
+            } else if !j.unavailable.is_empty() {
+                "unavailable"
+            } else {
+                j.agree = true;
+                "agrees"
+            };
+            if j.agree {
+                agreeing_hosts.insert(host(&p.endpoint));
+                if let Some(s) = j.slot {
+                    slots.insert(s);
+                }
+            }
+            providers.push(json!({ "id": p.id, "endpoint": p.endpoint, "verdict": verdict, "slot": j.slot,
+                                   "finalized_slot": j.finalized_slot, "disagree": j.disagree, "unavailable": j.unavailable }));
+        }
+        let ok = agreeing_hosts.len() >= needed && !any_disagree && slots.len() <= 1;
+        json!({ "ok": true, "chainId": self.chain_id, "root": root, "verdict": if ok { "ok" } else { "failed" },
+                "agreeing": agreeing_hosts.len(), "needed": needed, "slot": slots.iter().next(),
+                "providers": providers })
+    }
+}
