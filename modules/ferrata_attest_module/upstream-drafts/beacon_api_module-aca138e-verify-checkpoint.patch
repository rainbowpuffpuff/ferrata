+
+    fn verify_checkpoint(&self, chain_id: i64, root: String, expect_json: String) -> String {
+        let expect: crate::CheckpointExpect = if expect_json.trim().is_empty() {
+            crate::CheckpointExpect::default()
+        } else {
+            match serde_json::from_str(&expect_json) {
+                Ok(e) => e,
+                Err(e) => return err(format!("expect_json: {e}")),
+            }
+        };
+        match self.plan(chain_id) {
+            Ok(plan) => plan.verify_checkpoint(&root, &expect).to_string(),
+            Err(e) => e,
+        }
+    }
 }
 
