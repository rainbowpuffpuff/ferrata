+// ---- verify_checkpoint (checkpoint.rs) ----------------------------------------------------------------------------
+
+const CP_ROOT: &str = "0x3b901f5e0000000000000000000000000000000000000000000000000000ccf7c0";
+const CP_SLOT: u64 = 11_562_112;
+const SEPOLIA_GVR: &str = "0xd8ea171f3c94aea21ebc42a1ed61052acf3f9209c00e4efbaaddac09ed9b8078";
+
+/// A Sepolia provider: the checkpoint's block canonical at its slot, finalized at `finalized`, Sepolia's genesis and
+/// spec; `other_at_slot` puts another block at the slot.
+fn cp_provider(finalized: u64, other_at_slot: bool, genesis_time: u64) -> Server {
+    serve(move |path| {
+        let header = |root: &str, slot: u64| json!({ "data": { "root": root, "canonical": true,
+            "header": { "message": { "slot": slot.to_string() } } } }).to_string();
+        let root = &CP_ROOT[..66];
+        if path == format!("/eth/v1/beacon/headers/{root}") {
+            (200, header(root, CP_SLOT), 0)
+        } else if path == format!("/eth/v1/beacon/headers/{CP_SLOT}") {
+            let r = if other_at_slot { format!("0x{}", "ab".repeat(32)) } else { root.to_string() };
+            (200, header(&r, CP_SLOT), 0)
+        } else if path == "/eth/v1/beacon/headers/finalized" {
+            (200, header(&format!("0x{}", "cd".repeat(32)), finalized), 0)
+        } else if path == "/eth/v1/beacon/genesis" {
+            (200, json!({ "data": { "genesis_validators_root": SEPOLIA_GVR, "genesis_time": genesis_time.to_string() } }).to_string(), 0)
+        } else if path == "/eth/v1/config/spec" {
+            (200, json!({ "data": { "DEPOSIT_CHAIN_ID": "11155111" } }).to_string(), 0)
+        } else {
+            (404, "{}".into(), 0)
+        }
+    })
+}
+
+fn cp_expect() -> crate::CheckpointExpect {
+    crate::CheckpointExpect { genesis_validators_root: Some(SEPOLIA_GVR.into()), ..Default::default() }
+}
+
+#[test]
+fn verify_checkpoint_three_providers_agree() {
+    let s: Vec<Server> = (0..3).map(|_| cp_provider(CP_SLOT + 6240, false, 1_655_733_600)).collect();
+    let p = plan(11_155_111, s.iter().enumerate().map(|(i, x)| provider(&format!("p{i}"), &x.base)).collect());
+    let v = p.verify_checkpoint(&CP_ROOT[..66], &cp_expect());
+    assert_eq!(v["verdict"], "ok", "{v:#}");
+    assert_eq!(v["agreeing"], 3);
+    assert_eq!(v["slot"], CP_SLOT);
+    for x in &s {
+        assert!(x.hits().iter().any(|h| h.ends_with(&format!("/headers/{CP_SLOT}"))), "pinned, each provider asked");
+    }
+}
+
+#[test]
+fn verify_checkpoint_refuses_another_block_unfinalized_or_another_chain() {
+    let root = &CP_ROOT[..66];
+    for (label, bad) in [
+        ("another block at the slot", cp_provider(CP_SLOT + 6240, true, 1_655_733_600)),
+        ("not finalized there", cp_provider(CP_SLOT - 32, false, 1_655_733_600)),
+        ("another genesis", cp_provider(CP_SLOT + 6240, false, 1_606_824_023)),
+    ] {
+        let good: Vec<Server> = (0..3).map(|_| cp_provider(CP_SLOT + 6240, false, 1_655_733_600)).collect();
+        let mut list: Vec<Provider> = good.iter().enumerate().map(|(i, x)| provider(&format!("g{i}"), &x.base)).collect();
+        list.push(provider("bad", &bad.base));
+        let v = plan(11_155_111, list).verify_checkpoint(root, &cp_expect());
+        assert_eq!(v["verdict"], "failed", "{label}: {v:#}");
+        let b = v["providers"].as_array().unwrap().iter().find(|x| x["id"] == "bad").unwrap().clone();
+        assert_eq!(b["verdict"], "disagrees", "{label}: {b:#}");
+    }
+}
+
+#[test]
+fn verify_checkpoint_counts_hosts_and_skips_the_unavailable() {
+    let root = &CP_ROOT[..66];
+    let a = cp_provider(CP_SLOT + 6240, false, 1_655_733_600);
+    let b = cp_provider(CP_SLOT + 6240, false, 1_655_733_600);
+    // Two ids for one endpoint count once; a provider that cannot be reached is not counted.
+    let list = vec![provider("a", &a.base), provider("a2", &a.base), provider("b", &b.base), provider("down", "http://127.0.0.1:9")];
+    let v = plan(11_155_111, list).verify_checkpoint(root, &cp_expect());
+    assert_eq!(v["agreeing"], 2, "{v:#}");
+    assert_eq!(v["verdict"], "failed");
+    let down = v["providers"].as_array().unwrap().iter().find(|x| x["id"] == "down").unwrap().clone();
+    assert_eq!(down["verdict"], "unavailable");
+    let v = plan(11_155_111, vec![provider("a", &a.base), provider("b", &b.base)])
+        .verify_checkpoint(root, &crate::CheckpointExpect { min_providers: Some(2), ..cp_expect() });
+    assert_eq!(v["verdict"], "ok", "{v:#}");
+}
