== contract in lgx-ferrata_monitor_module/logos-ferrata_monitor_module-module-lib.lgx:
module ferrata_monitor_module {
  version "0.1.0"
  depends []

  method version() -> tstr description "The module's version and the monitor it was built from, as JSON."
  method check(request: tstr) -> tstr description "One offline verdict on a candidate checkpoint against node views (`monitor check`). JSON in and out."
  method node_view(request: tstr) -> tstr description "A node view from a LEZ sequencer's block record (`monitor node-view`). JSON in and out."
  method run(request: tstr) -> tstr description "`monitor run` with the given arguments for its `--max-polls` polls, then its state. JSON in and out."
  method start(request: tstr) -> tstr description "`monitor run` with the given arguments as a daemon in the module, until `stop`. JSON in and out."
  method status() -> tstr description "Whether the daemon runs, how it ended, its state file, as JSON."
  method stop() -> tstr description "Stop the daemon after the poll in hand (a `stopped` alert, the state saved); its status, as JSON."
}
