== contract in lgx-ferrata_attestor_module/logos-ferrata_attestor_module-module-lib.lgx:
module ferrata_attestor_module {
  version "0.1.0"
  depends []

  method version() -> tstr description "The module's version and the attestor it was built from, as JSON."
  method keygen(request: tstr) -> tstr description "A 32-byte attestation key written to a new file (`out`; `seed_label` only for devnet keys); its public key."
  method pubkey(request: tstr) -> tstr description "The public key of a 32-byte secret key file. JSON in and out (modules/README.md)."
  method deployment(request: tstr) -> tstr description "The deployment (chain, vault, configuration, channel) a checkpoint_b input serves. JSON in and out."
  method certify(request: tstr) -> tstr description "The channel key's one certificate of an attestation key for a deployment. JSON in and out."
  method tier(request: tstr) -> tstr description "The node's final tier as the attestor checks it: tip, key set, blocks per signer. JSON in and out."
  method attest(request: tstr) -> tstr description "Read the node's final tier, check it and sign its tip (final-tier message v2). JSON in and out."
  method verify(request: tstr) -> tstr description "Check published attestations: certificate and signature over the live key set. JSON in and out."
  method collect(request: tstr) -> tstr description "The collector: t of n valid attestations into a checkpoint_b input, the rule run natively. JSON in and out."
  method assemble(request: tstr) -> tstr description "An input with exactly the given attestations, unchecked (one the program must refuse). JSON in and out."
  method base(request: tstr) -> tstr description "Devnet set-up: a checkpoint_b input over final blocks from the node's answers. JSON in and out."
  method start(request: tstr) -> tstr description "Start the attestor's loop: ask the node, check, sign, publish, every poll. JSON in and out."
  method status() -> tstr description "The loop's rounds, what each did, and the last attestation, as JSON."
  method stop() -> tstr description "Stop the loop after the round in hand; its final status, as JSON."
}
