== contract in lgx-ferrata_attest_module/logos-ferrata_attest_module-module-lib.lgx:
module ferrata_attest_module {
  version "0.1.0"
  depends []

  method version() -> tstr description "The module's version, the ferrata-core it was built from and its BLS backend, as JSON."
  method dry_run_attest(request: tstr) -> tstr description "Prove one storage slot or one log against a header record as the attestation program\nwould, and return its verdict and code as JSON. `request` is JSON (modules/README.md)."
  method verify_checkpoint(request: tstr) -> tstr description "Recompute an instance id from a configuration and checkpoint, check the checkpoint's\nbootstrap as the program's `Init` does, and compare the checkpoint with the roots given.\n`request` and the reply are JSON (modules/README.md)."
  method fetch_log_proof(request: tstr) -> tstr description "Read a block and its receipts from a JSON-RPC endpoint (`rpc_url`), rebuild the receipts\ntrie, check it against the block's receipts root, and return one log's receipt proof.\n`request` and the reply are JSON (modules/README.md)."
  method build_attest_tx(request: tstr) -> tstr description "Build the attestation program's `Attest` message for a log or a storage slot at\n`header(id, slot)`, and name the account it is sent to. JSON in and out (modules/README.md)."
  method read_attestation(request: tstr) -> tstr description "Decode the program's `Attested` event and compare its statement ids with a dry run's.\nJSON in and out (modules/README.md)."
  method read_instance(request: tstr) -> tstr description "Decode an instance's state as LEZ holds it at `instance(id)`: id, configuration, activation,\nstore (finalized header, committees) and jobs applied. JSON in and out (modules/README.md)."
}
