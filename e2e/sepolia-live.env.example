# Copy to e2e/sepolia-live.env (not committed) and fill in. Paths only: no key and no password here.
# e2e/sepolia-cloud.sh reads it too: MODAL_PROFILE, and for `setup` the first four lines.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_FROM=0x79A95aE9A3f9000eb41F7CBAB6a6F97826895C07
ETH_KEYSTORE=/path/to/keystore/file
ETH_PASSWORD=/path/to/file/holding/the/keystore/password
MODAL_PROFILE=<profile that runs gpu-prover/modal_app.py>
# Optional: where cargo, r0vm and the prover image run, if not on this machine.
#FERRATA_MRUN=/path/to/mrun
#FERRATA_MWRAP=/path/to/mwrap
# Optional, gas (vault/script/roundtrip.sh): the node that prices every transaction (default SEPOLIA_RPC_URL; for a
# rehearsal on a fork, the real endpoint) and the gas limit over its estimate in percent (default 125).
#FERRATA_GAS_RPC=https://ethereum-sepolia-rpc.publicnode.com
#FERRATA_GAS_MARGIN_PCT=125
# Optional, LEZ (e2e/sepolia-live.sh): the deposits whose root LEZ attests (default "0 1") and the capture command.
#FERRATA_ATTEST_DEPOSITS="0 1"
