# The sub-projects keep their own .gitignore files; this one lists, for the whole repository, what
# is never committed.

# Build outputs
/target
/bench/target
/bench/exec/target
/lez/target
/lez/guests/*/target
/bridge/target
/bridge/guests/target
/checkpoint/target
/checkpoint/guests/target
/checkpoint/guests-plain/target
__pycache__/
*.pyc

# Foundry: dependencies (installed with forge install --no-git at the pins in vault/README.md and
# bridge/README.md) and build output
/vault/lib/
/vault/out/
/vault/cache/
/vault/broadcast/
/vault/snapshots/
/bridge/evm-verify/lib/
/bridge/evm-verify/out/
/bridge/evm-verify/cache/
/bridge/evm-verify/broadcast/

# Downloaded vectors (scripts/fetch-vectors.sh); vectors/acc-leaf.json is generated and committed,
# vectors/vault-tree-v2.json is the vault's own (vault/test/vectors/tree-v2.json), committed.
/vectors/*
!/vectors/acc-leaf.json
!/vectors/vault-tree-v2.json

# Generated fixtures, prover scratch and re-runs the sub-projects do not commit
/checkpoint/fixtures/
/checkpoint/artifacts/work/
/checkpoint/artifacts/*/receipt-succinct.bin
/checkpoint/results/*-build.log
/bridge/artifacts/work/
/bridge/artifacts/rerun/
/bridge/artifacts/rerun-lowload/
/bridge/artifacts/rerun-quiet/
/bridge/tmp/
/vault/notes/
/docs/design/finality-rule/results/*.tmp
/docs/design/finality-rule/results/run-all.log

# gpu-prover: binaries downloaded from the Volume (scripts/fetch.sh) and staged inputs
# (scripts/stage-inputs.sh, scripts/stage-lez.sh, lez/scripts/stage-prove-attest.sh); the
# MANIFEST.json files record their sha256.
/gpu-prover/bin/
/gpu-prover/prover/target/
/gpu-prover/inputs/programs/
/gpu-prover/inputs/fixtures/
/gpu-prover/inputs-lez/prove_private
/gpu-prover/inputs-lez/mainnet-p1899/
/gpu-prover/inputs-lez-attest/prove_attest
/gpu-prover/inputs-lez-attest/mainnet-attest-*/

# The live sequencer run (lez/live): the driver's build output if it is built in place, and the
# guest binaries deployed (they embed build paths; lez/live/README.md says how to obtain them)
/lez/live/driver/target
/lez/live/programs/*.bin

# End-to-end return leg (e2e/): the recorded guest program binaries (they embed the build machine's
# paths; their sha256 and image ids are in e2e/runs/*/programs.json) and the scratch of the Groth16
# wraps (the prover's input.json and proof.json)
/e2e/programs/
/e2e/runs/*/work/
/vault/script/runs/
/e2e/sepolia-live.env
/e2e/runs/*/sepolia-live.log
# forge's dry runs of the gas check name local paths
/e2e/runs/*/gas/*.forge.log

# The bridge program's prover binary staged by lez/scripts/stage-prove-bridge.sh (its sha256 is in MANIFEST.json)
/gpu-prover/inputs-lez-bridge/prove_bridge

# The crown run's local deployment records and logs
/vault/deployments/crown-*
/e2e/runs/crown-*/logs/
/e2e/runs/crown-*/anvil.log
/e2e/runs/crown-*/verifier.log

# checkpoint/attestor/zone-bridge.sh: the Groth16 prover inputs and outputs between the box and mwrap (not records)
/e2e/runs/zone-bridge-*/work/
/e2e/runs/zone-bridge-*/logs/.mark-*

# lez-v03-bridge/sepolia.sh: Sepolia deployment records written where forge may write (vault/deployments/), copied to the run
/vault/deployments/v03bridge-*
