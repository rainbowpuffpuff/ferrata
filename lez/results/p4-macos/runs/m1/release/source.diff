diff --git a/bridge/e2e/Cargo.toml b/bridge/e2e/Cargo.toml
index ef61a2b..da87985 100644
--- a/bridge/e2e/Cargo.toml
+++ b/bridge/e2e/Cargo.toml
@@ -10,8 +10,9 @@ publish = false
 ferrata-bridge-core = { path = "../crates/ferrata-bridge-core" }
 # Client only: execution and proving run in r0vm 3.0.5 (installed with rzup), over IPC.
 risc0-zkvm = { version = "=3.0.5", default-features = false, features = ["client"] }
-# `prove` exposes `prove::to_json`, which writes the input of RISC Zero's Groth16 prover image.
-risc0-groth16 = { version = "=3.0.5", features = ["prove"] }
+# `prove` (through the feature `wrap` below) exposes `prove::to_json`, which writes the input of RISC Zero's Groth16
+# prover image.
+risc0-groth16 = { version = "=3.0.5" }
 # `program-binary`: a user ELF combined with the v1compat kernel exactly as risc0-build 3.0.5 does (its
 # `GuestBuilder::build`: ProgramBinary::new(user_elf, V1COMPAT_ELF).encode()), the versions of bridge/Cargo.lock.
 risc0-binfmt = "=3.0.5"
@@ -20,3 +21,10 @@ anyhow = "1"
 bincode = "1.3"
 hex = "0.4"
 serde_json = "1"
+
+[features]
+# `wrap`, on by default: `p254` writes the Groth16 prover's input with risc0-groth16's `prove`, which also builds
+# risc0-sys's GPU kernels; on macOS those are Metal kernels, compiled with full Xcode's `metal`, which the Command Line
+# Tools lack. `--no-default-features` builds every other subcommand, the release's succinct `prove` included.
+default = ["wrap"]
+wrap = ["risc0-groth16/prove"]
